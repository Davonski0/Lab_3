   "source": [
    "$$ f(x) = \\sin{(\\frac{x}{3})} + \\cos{(2x)},\\ \\ \\ \\ x \\in [-5\\pi, 5\\pi] $$"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 16,
   "id": "f7557a48",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-11-02T05:06:49.269622Z",
