   "source": [
    "for i in range(30):\n",
    "    kernel = 1.0*RBF(length_scale=1.0)\n",
    "    gp = GaussianProcessRegressor(kernel=kernel, n_restarts_optimizer=10, normalize_y=True)\n",
    "    gp.fit(np.array(H), np.array(s))\n",
    "\n",
    "    H_sim = []\n",
    "    for j in range(100):\n",
    "        H_sim.append([np.random.uniform(0.1, 10), np.random.uniform(0.001, 1)])\n",
    "\n",
    "    y_pred, desv = gp.predict(np.array(H_sim), return_std=True)\n",
    "    y_upp = y_pred + 2*desv\n",
    "\n",
    "    h = H_sim[np.argmax(y_upp)]\n",
    "    auc = objetivo(h)\n",
    "    H.append(h)\n",
    "    s.append(auc)\n",
    "    print(\"Iteracion\", i + 1, \"ROC-AUC:\", auc)"
   ]
  },
