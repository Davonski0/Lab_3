    "    modelo = make_pipeline(StandardScaler(), SVC(C=H[0], gamma=H[1]))\n",
    "    scores = cross_val_score(modelo, x, y, cv=5, scoring=\"roc_auc\")\n",
    "    return scores.mean()\n",
    "\n",
    "objetivo([1, 0.1])"
