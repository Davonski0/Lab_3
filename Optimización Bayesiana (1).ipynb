     ]
    }
   ],
   "source": [
    "def g(X):\n",
    "    return np.sin(X/3) + np.cos(2*X)\n",
    "\n",
    "np.random.seed(67)\n",
    "X = np.random.uniform(-5*np.pi, 5*np.pi, 6).reshape(-1, 1)\n",
    "y = g(X)\n",
    "X_new = np.linspace(-5*np.pi, 5*np.pi, 10000).reshape(-1, 1)\n",
    "\n",
    "for i in range(30):\n",
    "    kernel = 1.0*RBF(length_scale=1.0)\n",
    "    gp = GaussianProcessRegressor(kernel=kernel, n_restarts_optimizer=10)\n",
    "    gp.fit(X, y)\n",
    "    y_pred, desv = gp.predict(X_new, return_std=True)\n",
    "\n",
    "    x_sig = X_new[np.argmax(desv)].reshape(-1, 1)  # Donde hay mas incertidumbre\n",
    "    X = np.vstack([X, x_sig])\n",
    "    y = g(X)\n",
    "\n",
    "gp.fit(X, y)\n",
    "y_pred, desv = gp.predict(X_new, return_std=True)\n",
    "y_upp = y_pred + 2*desv\n",
    "y_low = y_pred - 2*desv\n",
    "\n",
    "plt.figure(figsize=(12, 6))\n",
    "plt.plot(X_new, g(X_new), 'k', label='Función real')\n",
    "plt.plot(X_new, y_pred, 'b', label='Predicción')\n",
    "plt.fill_between(X_new.ravel(), y_low, y_upp, alpha=0.2, color='blue', label='Intervalo de confianza 95%')\n",
    "plt.scatter(X, y, c='r', marker='x', label='Puntos muestreados')\n",
    "plt.xlabel('X')\n",
    "plt.ylabel('y')\n",
    "plt.title('Selección por la mayor incertidumbre')\n",
    "plt.legend()\n",
    "plt.show()\n",
    "\n",
    "print(\"Puntos distintos:\", len(np.unique(X)))\n",
    "print(\"Incertidumbre maxima:\", desv.max())"
   ]
  },
